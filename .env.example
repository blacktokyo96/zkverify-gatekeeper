# Copy to .env and fill in. NEVER commit a real secret.
PORT=3000
# From the Agent Games dashboard: Manage Agents -> Rotate Secret (revealed once).
AGENT_GAMES_HMAC_SECRET=
# Optional: Kurier mainnet API key (kurier.xyz). Without it, responses carry
# proof + public_signals and no proof_tx (proof_tx is optional per /build).
KURIER_API_KEY=
# Max ms to spend generating the Groth16 proof before answering without one.
PROOF_BUDGET_MS=45000
